{
  "contract": 1,
  "renderers": {
    "turbozero/othello-episode": "episode.js",
    "turbozero/connect_four-episode": "episode.js",
    "turbozero/hex-episode": "episode.js",
    "turbozero/tic_tac_toe-episode": "episode.js"
  },
  "tabs": [
    {
      "title": "Run",
      "rows": [
        [
          {
            "type": "tiles"
          }
        ],
        [
          {
            "type": "chart",
            "title": "Headline",
            "metrics": [
              "engine_value_mse",
              "engine_top1",
              "memorized_value",
              "memorized_policy",
              "update_ratio",
              "epoch_seconds",
              "*_avg_outcome"
            ],
            "split": true
          }
        ],
        [
          {
            "type": "config"
          }
        ]
      ]
    },
    {
      "title": "Health",
      "rows": [
        [
          {
            "type": "chart",
            "title": "Health",
            "metrics": [
              "policy_loss",
              "value_loss",
              "grad_norm",
              "grad_norm_spike",
              "loss_spike",
              "nonfinite_steps",
              "episode_draw",
              "buffer_distinct_fraction"
            ],
            "split": true
          }
        ],
        [
          {
            "type": "chart",
            "title": "Self-play data",
            "metrics": [
              "data_target_prior_kl",
              "data_target_entropy",
              "data_prior_entropy",
              "data_top_move_change",
              "data_decided_share",
              "data_decided_share_late",
              "data_label_value_mse",
              "data_value_bias_black",
              "data_value_bias_white",
              "data_outcome_black",
              "data_collision",
              "data_pair_distance",
              "data_stored"
            ],
            "split": true
          }
        ],
        [
          {
            "type": "chart",
            "title": "Label headroom",
            "metrics": [
              "search*_top1",
              "search*_exp_regret",
              "search*_value_mse",
              "search_kl_*"
            ],
            "split": true
          }
        ]
      ]
    },
    {
      "title": "All metrics",
      "rows": [
        [
          {
            "type": "chart",
            "title": "All metrics",
            "metrics": [
              "*"
            ],
            "split": true
          }
        ],
        [
          {
            "type": "media",
            "title": "Media",
            "keys": [
              "*"
            ]
          }
        ]
      ]
    }
  ]
}
