{
  "contract": 1,
  "renderers": {
    "turbozero/othello-episode": "episode.js",
    "turbozero/connect_four-episode": "episode.js",
    "turbozero/hex-episode": "episode.js",
    "turbozero/tic_tac_toe-episode": "episode.js"
  },
  "tabs": [
    {
      "title": "Run",
      "rows": [
        [
          {
            "type": "tiles"
          }
        ],
        [
          {
            "type": "chart",
            "title": "Headline",
            "metrics": [
              "engine_value_mse",
              "engine_top1",
              "memorized_value",
              "memorized_policy",
              "update_ratio",
              "epoch_seconds",
              "*_avg_outcome"
            ],
            "split": true
          }
        ],
        [
          {
            "type": "config"
          }
        ]
      ]
    },
    {
      "title": "Health",
      "rows": [
        [
          {
            "type": "chart",
            "title": "Health",
            "metrics": [
              "policy_loss",
              "value_loss",
              "grad_norm",
              "grad_norm_spike",
              "loss_spike",
              "nonfinite_steps",
              "episode_draw",
              "buffer_distinct_fraction"
            ],
            "split": true
          }
        ]
      ]
    },
    {
      "title": "All metrics",
      "rows": [
        [
          {
            "type": "chart",
            "title": "All metrics",
            "metrics": [
              "*"
            ],
            "split": true
          }
        ],
        [
          {
            "type": "media",
            "title": "Media",
            "keys": [
              "*"
            ]
          }
        ]
      ]
    }
  ]
}
